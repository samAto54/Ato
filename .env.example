# Copy this file to .env and replace the placeholder value.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional. Change this to another model your OpenAI project can access.
ATO_MODEL=deepseek-v4-flash

# Persistent conversation memory settings.
ATO_MEMORY_FILE=data/memory.json
ATO_MEMORY_MAX_MESSAGES=40
