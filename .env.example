# Copy this file to .env and replace the placeholder value.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional. Change this to another model your OpenAI project can access.
ATO_MODEL=deepseek-v4-flash

# Persistent conversation memory settings.
ATO_MEMORY_FILE=data/memory.json
ATO_MEMORY_MAX_MESSAGES=40

# Context-window budgeting and compaction.
ATO_CONTEXT_MAX_TOKENS=12000
ATO_CONTEXT_RECENT_MESSAGES=12
ATO_CONTEXT_SUMMARY_MAX_CHARS=6000

# Root directory the Phase 3 read-only tools are allowed to inspect.
ATO_WORKSPACE_ROOT=.

# Append-only, redacted tool audit log.
ATO_AUDIT_FILE=data/audit.jsonl
