# Copy this file to .env and replace the placeholder value.
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Optional. Enables the confirmed web_search tool when configured.
TAVILY_API_KEY=your_tavily_api_key_here
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here

# Optional. Enables bounded read-only access to one GitHub repository.
ATO_GITHUB_REPOSITORY=owner/repository
GITHUB_TOKEN=your_github_token_here

# Optional. Change this to another model your OpenAI project can access.
ATO_MODEL=deepseek-v4-flash

# Persistent conversation memory settings.
ATO_MEMORY_FILE=data/memory.json
ATO_MEMORY_MAX_MESSAGES=40

# Context-window budgeting and compaction.
ATO_CONTEXT_MAX_TOKENS=12000
ATO_CONTEXT_RECENT_MESSAGES=12
ATO_CONTEXT_SUMMARY_MAX_CHARS=6000

# Durable user-approved facts (SQLite; generated locally and never committed).
ATO_LONG_TERM_MEMORY_FILE=data/long_term_memory.db
ATO_KNOWLEDGE_FILE=data/knowledge.db
# Persisted structured research sessions (SQLite; generated locally and never committed).
ATO_RESEARCH_FILE=data/research.db

# Recoverable pre-edit checkpoints (SQLite; generated locally and never committed).
ATO_EDIT_CHECKPOINT_FILE=data/edit_checkpoints.db

# Root directory the Phase 3 read-only tools are allowed to inspect.
ATO_WORKSPACE_ROOT=.

# Append-only, redacted tool audit log.
ATO_AUDIT_FILE=data/audit.jsonl

# Disabled by default. Enables confirmed offline Windows speech playback.
ATO_VOICE_ENABLED=false
# Existing local faster-whisper model directory; never downloaded automatically.
ATO_STT_MODEL_PATH=
